; dispatch.mil — indirect control transfer, both kinds.
;
; A tiny accumulator VM over (opcode, operand) byte pairs. The interpreter
; dispatches each opcode with `bri` into a handler EBB, which is what a
; threaded interpreter actually does: no compare chain, one computed goto.
; `mul` is a function instead of an EBB, reached with `calli`, so the same
; trick shows up on the call side.
;
;   acc = 0;  acc += 5;  acc *= 3;  acc -= 2   ->  13
;
; A table index is a value like any other: `con &label` gives an EBB index and
; `con @func` a function index, and the handler tables here are just "base
; index + opcode" because the labels are declared consecutively.

.data 0x1000
.u8 0, 5                        ; add 5
.u8 2, 3                        ; mul 3
.u8 1, 2                        ; sub 2
.u8 3, 0                        ; halt

.func main(0) -> 0
    a0  con 0x1000                  ; pc
    a1  con 0                       ; acc
                                ; belt: b0=acc b1=pc   (a0 drops first)

; ---------------------------------------------------------------------------
; The interpreter loop. Both bytes are loaded up front, three bundles apart,
; so the dispatch arithmetic fills the wait.

.ebb vm(2)                      ; b0=acc b1=pc
    m   load b1, 0, 1, zero, 3      ; op  = [pc],   lands at +3
    a0  con &h_add                  ; handler table base
                                ; belt: b0=base b1=acc b2=pc

    m   load b2, 1, 1, zero, 3      ; imm = [pc+1], lands at +3

    a0  nop

    a0  add b0, b1                  ; op + base = handler EBB index
    a1  con 2
                                ; imm (issued 3 bundles ago) drops before this
                                ; bundle's own results
                                ; belt: b0=2 b1=idx b2=imm b3=op b4=base
                                ;       b5=acc b6=pc

    a0  add b6, b0                  ; pc + 2
                                ; belt: b0=pc' b1=2 b2=idx b3=imm b4=op
                                ;       b5=base b6=acc b7=pc

    f   conform b3, b6, b0, b2      ; belt: b0=imm b1=acc b2=pc' b3=idx
                                ; the handler's entry arity is 3; idx rides
                                ; along above it and is truncated on the edge

    f   bri b3

; ---------------------------------------------------------------------------
; Handlers. Declared consecutively — `&h_add + opcode` is the dispatch table.
; Every one of them re-enters `vm` with (acc, pc).

.ebb h_add(3)                   ; b0=imm b1=acc b2=pc
    a0  add b1, b0
                                ; belt: b0=acc' b1=imm b2=acc b3=pc

    f   conform b0, b3              ; belt: b0=acc' b1=pc

    f   br vm

.ebb h_sub(3)                   ; b0=imm b1=acc b2=pc
    a0  sub b1, b0
                                ; belt: b0=acc' b1=imm b2=acc b3=pc

    f   conform b0, b3              ; belt: b0=acc' b1=pc

    f   br vm

.ebb h_mul(3)                   ; b0=imm b1=acc b2=pc
    a0  con @fmul
                                ; belt: b0=@fmul b1=imm b2=acc b3=pc

    f   calli b0, b2, b1 -> 1       ; fmul(acc, imm); args drop in listed
                                    ; order, so the callee sees b0=imm b1=acc
                                ; belt: b0=acc' b1=@fmul b2=imm b3=acc b4=pc

    f   conform b0, b4              ; belt: b0=acc' b1=pc

    f   br vm

.ebb h_halt(3)                  ; b0=imm b1=acc b2=pc
    f   conform b1                  ; belt: b0=acc

    f   sys 0                       ; exit(acc)

; ---------------------------------------------------------------------------
; The multiply handler, in its own frame so the 3-bundle latency is local.

.func fmul(2) -> 1              ; b0=imm b1=acc
    a0  mul b1, b0

    a0  nop

    a0  nop
                                ; belt: b0=acc*imm

    f   retn b0

; fib.mil — M4 / §14: recursive fib(20), printed in decimal.
;
; Every call gets a fresh belt and a fresh scratchpad, so nothing has to be
; saved across a call — that is the whole reason a 16-position belt is
; workable at all (PRD §6.1).

.data 0x2000
.zero 32                        ; decimal conversion buffer, 0x2000..0x201f

.data 0x2100
.ascii "\n"

.def BUFEND 0x2020

.func main(0) -> 0
    a0  con 20
                                ; belt: b0=20

    f   call fib, b0
                                ; belt: b0=fib(20) b1=20

    f   call printu, b0

    f   call putnl

    f   retn

; ---------------------------------------------------------------------------
; fib(n) = n < 2 ? n : fib(n-1) + fib(n-2)

.func fib(1) -> 1               ; b0=n
    a0  con 2
                                ; belt: b0=2 b1=n

    a0  lt  b1, b0                  ; n < 2
                                ; belt: b0=cond b1=2 b2=n

    f   conform b0, b2              ; belt: b0=cond b1=n

    f   brt b0, fib_base            ; not taken: falls through into fib_rec

.ebb fib_rec(2)                 ; b0=cond b1=n
    a0  con 1
                                ; belt: b0=1 b1=cond b2=n

    a0  sub b2, b0                  ; n-1
    a1  con 2
                                ; belt: b0=2 b1=n-1 b2=1 b3=cond b4=n

    a0  sub b4, b0                  ; n-2
                                ; belt: b0=n-2 b1=2 b2=n-1 b3=1 b4=cond b5=n

    f   call fib, b2                ; fib(n-1); the result retires this bundle
                                ; belt: b0=r1 b1=n-2 b2=2 b3=n-1 ...

    f   call fib, b1                ; fib(n-2)
                                ; belt: b0=r2 b1=r1 b2=n-2 ...

    a0  add b0, b1
                                ; belt: b0=r1+r2 ...

    f   retn b0

.ebb fib_base(2)                ; b0=cond b1=n
    f   retn b1

; ---------------------------------------------------------------------------
; printu(n) — write n in decimal to stdout. Digits are produced least
; significant first, so they are stored backwards from the end of the buffer.
;
; div and rem have latency 8, which dominates the loop: five bundles of the
; body do nothing but wait for them.

.func printu(1) -> 0            ; b0=n
    a0  con BUFEND
                                ; belt: b0=p b1=n

.ebb pu_loop(2)                 ; b0=p b1=n
    a0  con 10
    a1  con 1
                                ; belt: b0=1 b1=10 b2=p b3=n

    a0  rem b3, b1                  ; n % 10   } both retire at the end of +7
    a1  div b3, b1                  ; n / 10   }

    a0  sub b2, b0                  ; p-1
                                ; belt: b0=p-1 b1=1 b2=10 b3=p b4=n

    a0  con 48                      ; '0'
                                ; belt: b0=48 b1=p-1 b2=1 b3=10 b4=p b5=n

    a0  nop

    a0  nop

    a0  nop

    a0  nop

    a0  nop
                                ; div/rem land here, rem first (slot order)
                                ; belt: b0=quot b1=digit b2=48 b3=p-1 b4=1 ...

    a0  add b1, b2                  ; '0' + digit
                                ; belt: b0=char b1=quot b2=digit b3=48 b4=p-1 ...

    m   store b4, 0, 1, b0          ; *(p-1) = char
    f   conform b4, b1              ; belt: b0=p-1 b1=quot

    f   brt b1, pu_loop

.ebb pu_done(2)                 ; b0=p b1=0
    a0  con BUFEND
                                ; belt: b0=end b1=p b2=0

    a0  sub b0, b1                  ; len
                                ; belt: b0=len b1=end b2=p b3=0

    a0  or  b2, b2                  ; copy p — there is no `mov`
    a1  con 1
                                ; belt: b0=fd b1=ptr b2=len

    f   sys 1

    f   retn

; ---------------------------------------------------------------------------

.func putnl(0) -> 0
    a0  con 1                       ; len
    a1  con 0x2100                  ; ptr
                                ; belt: b0=ptr b1=len

    a0  con 1                       ; fd
                                ; belt: b0=fd b1=ptr b2=len

    f   sys 1

    f   retn

; hello.mil — M1: the smallest useful program.
;
; `sys 1` is write(fd=b0, ptr=b1, len=b2), so the three values have to be
; dropped in the order len, ptr, fd — the last one dropped is b0.

.data 0x1000
.ascii "hello, millet\n"

.func main(0) -> 0
    a0  con 14                  ; len
    a1  con 0x1000              ; ptr
                                ; belt: b0=ptr b1=len

    a0  con 1                   ; fd
                                ; belt: b0=fd b1=ptr b2=len

    f   sys 1
                                ; belt: b0=bytes_written b1=fd b2=ptr b3=len

    f   retn

; strlen.mil — M3: a loop with a deferred load inside the body, written with
; named belt values.
;
; `-> name` names what an op drops and `%name` reads it back; the assembler
; resolves the name to the position it holds *in that bundle*. Nothing about
; the machine changes — this file encodes byte-identically to the same program
; written `b0`, `b3`, `b5` — but nobody has to count.
;
; The load is issued at the top of the body and used three bundles later, so
; nothing is ever in flight across the back edge (PRD §4, check E9).
;
; Exits with the string length (13) as the process exit code.

.data 0x1000
.asciiz "hello, millet"

.func main(0) -> 0
    a0  con 0x1000 -> p

    f   call strlen, %p -> len

    f   sys 0                   ; exit(len)

; ---------------------------------------------------------------------------

.func strlen(p) -> 1
    a0  con 0 -> count
                                ; falls through into sl_loop, which is an edge

.ebb sl_loop(count, p)
    m   load  %p, 0, 1, zero, 3 -> byte     ; retires end of +2
    a0  con   1 -> one

    a0  add   %count, %one -> count1
    a1  add   %p, %one -> p1

    a0  nop                                 ; the load lands here

    f   conform %count1, %p1, %byte         ; carried pair, then the condition

    f   brt %byte, sl_loop                  ; byte is truncated away on entry

.ebb sl_done(count, p, term)
    a0  con 1 -> one

    a0  sub %count, %one -> len             ; the terminator was counted

    f   retn %len

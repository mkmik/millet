; divmod.mil — M4: a function returning two results.
;
; `retn` drops its results onto the caller's belt in listed order, so the
; last-listed one becomes b0 there — the same convention as `call`, and the
; opposite of `conform`.
;
; Exits with 142: 100/7 = 14 remainder 2.

.func main(0) -> 0
    a0  con 100
    a1  con 7
                                ; belt: b0=7 b1=100

    f   call divmod, b0, b1         ; callee sees b0=100 b1=7
                                ; belt: b0=rem b1=quot b2=7 b3=100

    a0  con 10
                                ; belt: b0=10 b1=rem b2=quot ...

    a0  mul b2, b0                  ; latency 3

    a0  nop

    a0  nop
                                ; belt: b0=quot*10 b1=10 b2=rem b3=quot

    a0  add b0, b2

    f   sys 0                       ; exit(142)

; ---------------------------------------------------------------------------

.func divmod(2) -> 2            ; b0=a b1=b
    a0  div b0, b1                  ; } latency 8; both land at the end of +7,
    a1  rem b0, b1                  ; } a0 first, so the remainder ends at b0

    a0  nop

    a0  nop

    a0  nop

    a0  nop

    a0  nop

    a0  nop

    a0  nop
                                ; belt: b0=rem b1=quot b2=a b3=b

    f   retn b1, b0                 ; caller gets b0=rem b1=quot
